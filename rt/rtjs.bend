def src.p8() -> String:
  "// type's tags (Bend 2.0.32 fail-stops there, #1105).\n" ++
  "function io_tags(ty, tags, k) {\n" ++
  "  return (x) => {\n" ++
  "    if (!tags.includes(x?.$)) {\n" ++
  "      bend_fail(ty + \" has no tag \" + x?.$ + \" (its tags: \" + tags.join(\", \") + \"); a tag names its\" +\n" ++
  "        \" constructor as the loading file sees it, which a later version will make the same everywhere (#1105)\");\n" ++
  "    }\n" ++
  "    return k(x);\n" ++
  "  };\n" ++
  "}\n" ++
  "\n" ++
  "// Chan\n" ++
  "// ----\n" ++
  "\n" ++
  "const CHAN_RECV = Symbol();\n" ++
  "\n" ++
  "function chan_wake(row, x) {\n" ++
  "  const w = row.wait.shift();\n" ++
  "  io_push(w.cont, x, false);\n" ++
  "  return w.item;\n" ++
  "}\n" ++
  "\n" ++
  "function chan_take(row) {\n" ++
  "  const v = row.ring.shift();\n" ++
  "  if (row.wait.length > 0) row.ring.push(chan_wake(row, true));\n" ++
  "  return v;\n" ++
  "}\n" ++
  "\n" ++
  "function chan_shut(row) {\n" ++
  "  row.shut = true;\n" ++
  "  while (row.wait.length > 0) {\n" ++
  "    chan_wake(row, row.wait[0].item === CHAN_RECV ? { $: \"None\" } : false);\n" ++
  "  }\n" ++
  "}\n" ++
  "\n" ++
  "// Entry points\n" ++
  "// ============\n" ++
  "\n" ++
  "let cli_args = [];\n" ++
  "\n" ++
  "// IO.args starts with the program as invoked (the JS file).\n" ++
  "function cli(argv) {\n" ++
  "  cli_args.push(argv[0]);\n" ++
  "  for (let i = 1; i < argv.length; i += 1) {\n" ++
  "    if (argv[i] === \"--\") {\n" ++
  "      cli_args.push(...argv.slice(i + 1));\n" ++
  "      break;\n" ++
  "    } else if (argv[i] === \"--bend-help\") {\n" ++
  "      io_out(1, io_bytes(\"usage: \" + process.argv[1] + \" [arguments]\\n\"));\n" ++
  "      process.exit(0);\n" ++
  "    } else if (argv[i] === \"--threads\" || argv[i] === \"--gpu\") {\n" ++
  "      i += 1;\n" ++
  "    } else {\n" ++
  "      cli_args.push(argv[i]);\n" ++
  "    }\n" ++
  "  }\n" ++
  "}\n" ++
  "\n" ++
  "function bend_run(main) {\n" ++
  "  cli(process.argv.slice(1));\n"

def src.p9() -> String:
  "  let code;\n" ++
  "  try {\n" ++
  "    code = io_run(main());\n" ++
