  "    code = 1;\n" ++
  "  }\n" ++
  "  process.exit(code);\n" ++
  "}\n" ++
  "\n" ++
  "function bend_run_value(main, show) {\n" ++
  "  cli(process.argv.slice(1));\n" ++
  "  try {\n" ++
  "    io_out(1, io_bytes(show(main()) + \"\\n\"));\n" ++
  "  } catch (e) {\n" ++
  "    io_errs(e instanceof RangeError ? \"bend: memory fault (machine stack overflow?)\" : String(e));\n" ++
  "    process.exit(1);\n" ++
  "  }\n" ++
  "  process.exit(0);\n" ++
  "}\n" ++
