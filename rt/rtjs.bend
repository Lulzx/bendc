  "          need.read ? undefined : performance.now() + Number(op.args[0]));\n" ++
  "        break;\n" ++
  "      }\n" ++
  "      const x = op.run(...op.args, op.kont);\n" ++
  "      if (x === undefined) break;\n" ++
  "      op = op.kont(x);\n" ++
  "    }\n" ++
  "  }\n" ++
  "}\n" ++
  "\n" ++
