def src.p6() -> String:
  "}\n" ++
  "\n" ++
  "// Bytes cross as they are (0..255), one List cell each, with no UTF-8 in\n" ++
  "// either direction; io_unlist answers null if a value is past 255.\n" ++
  "function io_list(b, n) {\n" ++
  "  let xs = { $: \"Nil\" };\n" ++
  "  for (let i = n; i > 0; i -= 1) xs = { $: \"Con\", head: b[i - 1], tail: xs };\n" ++
  "  return xs;\n" ++
  "}\n" ++
  "\n" ++
  "function io_unlist(xs) {\n" ++
  "  const b = [];\n" ++
  "  for (; xs.$ === \"Con\"; xs = xs.tail) b.push(xs.head);\n" ++
  "  return b.some((x) => x > 255) ? null : Uint8Array.from(b);\n" ++
  "}\n" ++
  "\n" ++
  "function io_addr(host, port) {\n" ++
  "  const part = host.split(\".\");\n" ++
  "  const deci = (p) => /^(0|[1-9]\\d{0,2})$/.test(p) && Number(p) < 256;\n" ++
  "  if (port > 65535 || part.length !== 4 || !part.every(deci)) return null;\n" ++
  "  const b = new Uint8Array(16);\n" ++
  "  const head = io_sys().mac ? [16, 2] : [2, 0];\n" ++
  "  b.set([...head, port >> 8, port & 255, ...part.map(Number)]);\n" ++
  "  return b;\n" ++
  "}\n" ++
  "\n" ++
  "// A computation to run: fun applied to arg is its next request.\n" ++
  "function io_push(fun, arg, fresh) {\n" ++
  "  const io = globalThis.BEND_IO;\n" ++
  "  io.runs.push({ fun, arg });\n" ++
  "  io.live += fresh ? 1 : 0;\n" ++
  "}\n" ++
  "\n" ++
  "function io_wait(io) {\n" ++
  "  const soon = io.waits.reduce((m, w) => Math.min(m, w.at ?? m), Infinity);\n" ++
  "  const ms = soon === Infinity ? -1 : Math.max(0, Math.ceil(soon - performance.now()));\n" ++
  "  const fds = io.waits.filter((w) => w.fd !== undefined);\n" ++
  "  if (fds.length === 0) {\n" ++
  "    // Only deadlines: sleep until the first one.\n" ++
  "    if (ms > 0) Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms);\n" ++
  "  } else {\n" ++
  "    const top = fds.reduce((m, w) => Math.max(m, w.fd), 0);\n" ++
  "    const len = (top >> 6 << 3) + 8;\n" ++
  "    const set = new Uint8Array(2 * len);\n" ++
  "    const at = (w) => (w.out ? len : 0) + (w.fd >> 3);\n" ++
  "    for (const w of fds) set[at(w)] |= 1 << (w.fd & 7);\n" ++
  "    const tv = new BigInt64Array([BigInt(ms / 1000 | 0), BigInt(ms % 1000 * 1000)]);\n" ++
  "    const sys = io_sys();\n" ++
  "    sys.select(top + 1, sys.ptr(set), sys.ptr(set, len), null, ms < 0 ? null : sys.ptr(tv));\n" ++
  "    io.ready = (w) => set[at(w)] & 1 << (w.fd & 7);\n" ++
  "  }\n" ++
  "  const now = performance.now();\n" ++
  "  io.waits = io.waits.filter((w) => {\n" ++
  "    const ready = w.at <= now || (w.fd !== undefined && io.ready !== undefined && io.ready(w));\n" ++
  "    if (ready) io_push(io_wake, w, false);\n" ++
  "    return !ready;\n" ++
  "  });\n" ++
  "  io.ready = undefined;\n" ++
  "}\n" ++
  "\n"

def src.p7() -> String:
  "// Resumes k with more's value; undefined means re-parked.\n" ++
  "function io_wake(w) {\n" ++
  "  const x = w.more();\n" ++
  "  return x === undefined ? undefined : w.k(x);\n" ++
  "}\n" ++
  "\n" ++
  "// Parks for read/write (out) or a deadline at (performance.now()).\n" ++
  "function io_park_on(fd, out, k, more, at) {\n" ++
  "  globalThis.BEND_IO.waits.push({ fd, out, k, more, at });\n" ++
  "}\n" ++
  "\n" ++
  "function io_run(m) {\n" ++
  "  const io = { runs: [], live: 0, waits: [] };\n" ++
  "  globalThis.BEND_IO = io;\n" ++
  "  io_push(m(null), (x) => ({ $: \"Emit\", value: x }), true);\n" ++
  "  for (;;) {\n" ++
  "    if (io.runs.length === 0) {\n" ++
  "      if (io.live === 0) return 0;\n" ++
  "      if (io.waits.length === 0) {\n" ++
  "        io_errs(\"bend: deadlock: every computation waits on a channel\");\n" ++
  "        return 1;\n" ++
  "      }\n" ++
  "      io_wait(io);\n" ++
  "      continue;\n" ++
  "    }\n" ++
  "    const s = io.runs.shift();\n" ++
  "    let op = s.fun(s.arg);\n" ++
  "    // An IO value from an effect (IO.spawn's) takes its erased type first.\n" ++
  "    if (typeof op === \"function\") op = op(s.arg);\n" ++
  "    while (op !== undefined) {\n" ++
  "      if (op.$ === \"Emit\") {\n" ++
  "        io.live -= 1;\n" ++
  "        break;\n" ++
  "      }\n" ++
  "      if (op.$ === \"Halt\") {\n" ++
  "        io_errs(op.message);\n" ++
  "        return op.code;\n" ++
  "      }\n" ++
  "      if (op.run === undefined) bend_fail(\"an effect with no JS implementation: \" + op.name);\n" ++
  "      const need = op.need?.() ?? {};\n" ++
  "      if (need.time || need.read) {\n" ++
  "        const o = op;\n" ++
  "        const more = () => o.run(...o.args, o.kont);\n" ++
