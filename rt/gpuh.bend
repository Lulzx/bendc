  "// The words of the object at v: in the arena or in the CPU's heap.\n" ++
  "KINLINE bool k_in(KTHR KCtx *c, KW v) { return v - c->ab < c->an; }\n" ++
  "KINLINE KW k_word(KTHR KCtx *c, KW v, KW i) {\n" ++
