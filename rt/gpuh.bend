  "\n" ++
  "#define KU32(x) ((KW)(KU)(x))\n" ++
  "#define KU1(name, expr) KINLINE KW KF_U32_d##name(KTHR KCtx *c, KW a) { return expr; }\n" ++
  "#define KU2(name, expr) KINLINE KW KF_U32_d##name(KTHR KCtx *c, KW a, KW b) { return expr; }\n" ++
