  "\n" ++
  "// The queue (Vyukov's bounded MPMC queue): an entry is {pc, fp, rv, dep}.\n" ++
  "KINLINE bool k_push_task(KTHR KCtx *c, KW pc, KW fp, KW rv, KW dep) {\n" ++
  "  KW mask = c->P->qcap - 1;\n" ++
  "  KU pos = K_LOAD(&c->A[KA_QTAIL]);\n" ++
  "  for (int tries = 0;; tries++) {\n" ++
  "    if (tries > 100000) return false;\n" ++
  "    KU seq = K_LOAD(&c->A[KA_SEQ + (pos & mask)]);\n" ++
  "    KI dif = (KI)(seq - pos);\n" ++
  "    if (dif == 0) {\n" ++
  "      KU e = pos;\n" ++
  "      if (K_CAS(&c->A[KA_QTAIL], e, pos + 1)) break;\n" ++
  "      pos = e;\n" ++
