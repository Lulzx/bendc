  "\n" ++
  "KINLINE void k_fail(KTHR KCtx *c, KU e) {\n" ++
  "  if (c->err == 0) c->err = e;\n" ++
  "}\n" ++
  "\n" ++
  "// n words from the lane's heap chunk; the word before an object holds its\n" ++
  "// size (the host copies results out with it). Chunk 0 is scratch: a lane\n" ++
  "// that ran out writes there, and stops.\n" ++
  "KINLINE KW k_alloc(KTHR KCtx *c, KW n) {\n" ++
  "  if (c->hp + n + 1 > c->he) {\n" ++
  "    KW need = n + 1 > K_CHUNK ? n + 1 : K_CHUNK;\n" ++
  "    KW k = (need + K_CHUNK - 1) / K_CHUNK;\n" ++
  "    KW at = (KW)K_ADD(&c->A[KA_HEAP], (KU)k);\n" ++
  "    KW start = c->P->heap0 + at * K_CHUNK;\n" ++
  "    if (n + 1 > K_CHUNK || start + k * K_CHUNK > c->P->heap0 + c->P->heapw) {\n" ++
