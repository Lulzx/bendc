  "KF2(atan2, KUF(KMF(atan2)(x, y)))\n" ++
  "KF2(is__eq, KBOOL(x == y))\n" ++
  "KF2(is__ne, KBOOL(x != y))\n" ++
  "KF2(is__lt, KBOOL(x < y))\n" ++
  "KF2(is__le, KBOOL(x <= y))\n" ++
  "KF2(is__gt, KBOOL(x > y))\n" ++
  "KF2(is__ge, KBOOL(x >= y))\n" ++
  "KF1(neg, KUF(-x))\n" ++
  "KF1(abs, KUF(KMF(fabs)(x)))\n" ++
  "KF1(sqrt, KUF(KMF(sqrt)(x)))\n" ++
  "KF1(exp, KUF(KMF(exp)(x)))\n" ++
  "KF1(log, KUF(KMF(log)(x)))\n" ++
  "KF1(log2, KUF(KMF(log2)(x)))\n" ++
  "KF1(log10, KUF(KMF(log10)(x)))\n" ++
  "KF1(sin, KUF(KMF(sin)(x)))\n" ++
  "KF1(cos, KUF(KMF(cos)(x)))\n" ++
  "KF1(tan, KUF(KMF(tan)(x)))\n" ++
  "KF1(asin, KUF(KMF(asin)(x)))\n" ++
  "KF1(acos, KUF(KMF(acos)(x)))\n" ++
  "KF1(atan, KUF(KMF(atan)(x)))\n" ++
  "KF1(sinh, KUF(KMF(sinh)(x)))\n" ++
  "KF1(cosh, KUF(KMF(cosh)(x)))\n" ++
  "KF1(tanh, KUF(KMF(tanh)(x)))\n" ++
  "KF1(floor, KUF(KMF(floor)(x)))\n" ++
  "KF1(ceil, KUF(KMF(ceil)(x)))\n" ++
  "KF1(trunc, KUF(KMF(trunc)(x)))\n" ++
  "KF1(bits, KU32(a))\n" ++
  "KF1(to__u32, x <= 0.0f ? 0 : x >= 4294967295.0f ? (KW)0xffffffffu : (KW)(KU)x)\n" ++
  "KINLINE KW KF_F32_dshow(KTHR KCtx *c, KW a) { k_fail(c, KE_FX); return 0; }\n" ++
  "KINLINE KW KF_F32_dread(KTHR KCtx *c, KW a) { k_fail(c, KE_FX); return 0; }\n" ++
  "\n" ++
  "\n"

def mid() -> String:
  "\n" ++
  "// Applies closure f to x; the value goes to block ret.\n" ++
  "KINLINE void k_call_clo(KTHR KCtx *c, KW f, KW x, KW ret) {\n" ++
  "  KW fw = k_word(c, f, 0), ar = k_word(c, f, 1), n = k_word(c, f, 2);\n" ++
  "  KW l = (fw >> 52) == 0x7ff ? (fw & 0xffffffffu) : k_fn_label(c, fw);\n" ++
  "  if (l == 0 || l >= K_NLABELS) {\n" ++
  "    k_fail(c, KE_FX);\n" ++
  "    c->rv = 0;\n" ++
  "    c->pc = ret;\n" ++
  "    return;\n" ++
  "  }\n" ++
  "  if (n + 1 < ar) {\n" ++
  "    KW p = k_alloc(c, n + 4);\n" ++
  "    KW w = KIX(c, p);\n" ++
  "    c->H[w] = KCLO | l;\n" ++
  "    c->H[w + 1] = ar;\n" ++
  "    c->H[w + 2] = n + 1;\n" ++
  "    for (KW i = 0; i < n; i++) c->H[w + 3 + i] = k_word(c, f, 3 + i);\n" ++
  "    c->H[w + 3 + n] = x;\n" ++
  "    c->rv = p;\n" ++
  "    c->pc = ret;\n" ++
  "    return;\n" ++
  "  }\n" ++
  "  KW nf = k_push(c, ret, K_FRAME[l]);\n" ++
  "  for (KW i = 0; i < n; i++) c->H[nf + 4 + i] = k_word(c, f, 3 + i);\n" ++
  "  c->H[nf + 4 + n] = x;\n" ++
  "  c->fp = nf;\n" ++
  "  c->pc = l;\n" ++
  "}\n" ++
  "\n" ++
  "#ifdef __METAL_VERSION__\n" ++
  "kernel void bend_kernel(device coherent(device) KW *H [[buffer(0)]], device KAU *A [[buffer(1)]],\n" ++
  "  constant KParams &PP [[buffer(2)]], device KW *G [[buffer(3)]], uint lane [[thread_position_in_grid]]) {\n" ++
  "  constant KParams *P = &PP;\n" ++
  "#else\n" ++
  "static void bend_kernel(KW *H, KAU *A, const KParams *P, KW *G, uint32_t lane) {\n" ++
  "#endif\n" ++
  "  if (lane >= P->nlanes) return;\n" ++
  "  KCtx cx;\n" ++
  "  KTHR KCtx *c = &cx;\n" ++
  "  c->H = H;\n" ++
  "  c->G = G;\n" ++
  "  c->A = A;\n" ++
  "  c->P = P;\n" ++
  "  c->ab = P->ab;\n" ++
  "  c->an = P->an;\n" ++
  "  c->gb = P->gb;\n" ++
  "  c->err = 0;\n" ++
  "  KW ls = P->lane0 + (KW)lane * 8;\n" ++
  "  c->pc = H[ls];\n" ++
  "  c->fp = H[ls + 1];\n" ++
  "  c->rv = H[ls + 2];\n" ++
  "  c->dep = H[ls + 3];\n" ++
  "  c->hp = H[ls + 4];\n" ++
  "  c->he = H[ls + 5];\n" ++
  "  c->ax = H[ls + 6];\n" ++
  "  KW budget = P->budget;\n" ++
  "  for (KW step = 0; step < budget; step++) {\n" ++
  "    if (c->pc == PC_IDLE) {\n" ++
  "      if (K_LOAD(&A[KA_DONE]) != 0 || K_LOAD(&A[KA_ERR]) != 0) break;\n" ++
  "      if (!k_pop_task(c)) continue;\n" ++
  "    }\n" ++
  "    switch (c->pc) {\n" ++
  "      case PC_ROOT: {\n" ++
  "        H[2] = c->rv;\n" ++
  "        K_FENCE();\n" ++
  "        K_STORE(&A[KA_DONE], 1u);\n" ++
  "        c->pc = PC_IDLE;\n" ++
  "        break;\n" ++
  "      }\n" ++
  "      case PC_JOIN: {\n" ++
  "        k_arrive(c, c->fp, c->ax, c->rv);\n" ++
  "        break;\n" ++
  "      }\n" ++
  "      case PC_TASK: {\n" ++
  "        // A forked thunk: rv is its closure, fp its join, dep its depth\n" ++
  "        // and (dep >> 32) its index.\n" ++
  "        KW i = c->dep >> 32;\n" ++
  "        c->dep &= 0xffffffffu;\n" ++
  "        k_call_clo(c, c->rv, 0, PC_JOIN);\n" ++
  "        c->H[c->fp + 2] = i;\n" ++
  "        break;\n" ++
  "      }\n" ++
  "\n"

def tail() -> String:
  "      default: {\n" ++
  "        k_fail(c, KE_PC);\n" ++
  "        break;\n" ++
  "      }\n" ++
  "    }\n" ++
  "    if (c->err != 0) {\n" ++
  "      KU z = 0;\n" ++
  "      K_CAS(&A[KA_ERR], z, c->err);\n" ++
  "      break;\n" ++
  "    }\n" ++
  "  }\n" ++
  "  H[ls] = c->pc;\n" ++
  "  H[ls + 1] = c->fp;\n" ++
  "  H[ls + 2] = c->rv;\n" ++
  "  H[ls + 3] = c->dep;\n" ++
  "  H[ls + 4] = c->hp;\n" ++
  "  H[ls + 5] = c->he;\n" ++
  "  H[ls + 6] = c->ax;\n" ++
  "}\n" ++
  "\n"

def head_lit() -> String:
  "\"// gpu.h: the device side of f!(x) calls, shared by the Metal kernel and the\\n\"\n" ++
  "\"// CPU simulator (the same text compiles as MSL and as C).\\n\"\n" ++
  "\"//\\n\"\n" ++
  "\"// bendc compiles every function a !-call can reach into one flat state\\n\"\n" ++
  "\"// machine: a frame per call, a case per block, `pc` the block to run. A\\n\"\n" ++
  "\"// parallel let pushes its thunks to a lock-free queue and continues through\\n\"\n" ++
  "\"// a join record, so a lane never blocks: whoever brings a join its last\\n\"\n" ++
  "\"// value runs the continuation. Values are the CPU's words. The device reads\\n\"\n" ++
  "\"// the CPU heap in place (unified memory) and builds new objects in an arena\\n\"\n" ++
  "\"// the host copies the result out of. Anything the device cannot do (an\\n\"\n" ++
  "\"// effect, a Nat past 2^63, a full arena or queue, a failed match, a closure\\n\"\n" ++
  "\"// it has no code for) sets an error, and the host runs the call on the CPU.\\n\"\n" ++
  "\"//\\n\"\n" ++
  "\"// bendc puts its tables where //@TABLES is and its cases where //@CASES is.\\n\"\n" ++
  "\"// Every name starts with k or K: the C version shares a file with bendrt.h.\\n\"\n" ++
  "\"\\n\"\n" ++
  "\"#ifdef __METAL_VERSION__\\n\"\n" ++
  "\"#include <metal_stdlib>\\n\"\n" ++
  "\"using namespace metal;\\n\"\n" ++
  "\"typedef ulong KW;\\n\"\n" ++
  "\"typedef uint KU;\\n\"\n" ++
  "\"typedef int KI;\\n\"\n" ++
  "\"#define KDEV device\\n\"\n" ++
  "\"#define KCOH device coherent(device)\\n\"\n" ++
  "\"#define KTHR thread\\n\"\n" ++
  "\"#define KCONST constant\\n\"\n" ++
  "\"#define KCP constant\\n\"\n" ++
  "\"typedef atomic_uint KAU;\\n\"\n" ++
  "\"#define K_LOAD(p) atomic_load_explicit((p), memory_order_relaxed)\\n\"\n" ++
  "\"#define K_STORE(p, v) atomic_store_explicit((p), (v), memory_order_relaxed)\\n\"\n" ++
  "\"#define K_ADD(p, v) atomic_fetch_add_explicit((p), (v), memory_order_relaxed)\\n\"\n" ++
  "\"#define K_SUB(p, v) atomic_fetch_sub_explicit((p), (v), memory_order_relaxed)\\n\"\n" ++
  "\"#define K_CAS(p, e, v) atomic_compare_exchange_weak_explicit((p), &(e), (v), memory_order_relaxed, memory_order_relaxed)\\n\"\n" ++
  "\"#define K_FENCE() atomic_thread_fence(mem_flags::mem_device, memory_order_seq_cst, thread_scope_device)\\n\"\n" ++
  "\"#define KF(u) as_type<float>((uint)(u))\\n\"\n" ++
  "\"#define KUF(f) ((KW)as_type<uint>((float)(f)))\\n\"\n" ++
  "\"#define KMF(n) n\\n\"\n" ++
  "\"#define KINLINE inline\\n\"\n" ++
  "\"#define K_ATW(p) ((device atomic_uint *)(p))\\n\"\n" ++
  "\"#else\\n\"\n" ++
  "\"typedef uint64_t KW;\\n\"\n" ++
  "\"typedef uint32_t KU;\\n\"\n" ++
  "\"typedef int32_t KI;\\n\"\n" ++
  "\"#define KDEV\\n\"\n" ++
  "\"#define KCOH\\n\"\n" ++
  "\"#define KTHR\\n\"\n" ++
  "\"#define KCONST static const\\n\"\n" ++
  "\"#define KCP const\\n\"\n" ++
  "\"typedef uint32_t KAU;\\n\"\n" ++
  "\"#define K_LOAD(p) __atomic_load_n((p), __ATOMIC_SEQ_CST)\\n\"\n" ++
  "\"#define K_STORE(p, v) __atomic_store_n((p), (v), __ATOMIC_SEQ_CST)\\n\"\n" ++
  "\"#define K_ADD(p, v) __atomic_fetch_add((p), (v), __ATOMIC_SEQ_CST)\\n\"\n" ++
  "\"#define K_SUB(p, v) __atomic_fetch_sub((p), (v), __ATOMIC_SEQ_CST)\\n\"\n" ++
  "\"#define K_CAS(p, e, v) __atomic_compare_exchange_n((p), &(e), (v), 1, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST)\\n\"\n" ++
  "\"#define K_FENCE() __atomic_thread_fence(__ATOMIC_SEQ_CST)\\n\"\n" ++
  "\"static inline float k_f_of(KW u) { union { uint32_t i; float f; } x; x.i = (uint32_t)u; return x.f; }\\n\"\n" ++
  "\"static inline KW k_u_of(float f) { union { uint32_t i; float f; } x; x.f = f; return x.i; }\\n\"\n" ++
  "\"#define KF(u) k_f_of(u)\\n\"\n" ++
  "\"#define KUF(f) k_u_of(f)\\n\"\n" ++
  "\"#define KMF(n) n##f\\n\"\n" ++
  "\"#define KINLINE static inline\\n\"\n" ++
  "\"#define K_ATW(p) ((KAU *)(p))\\n\"\n" ++
  "\"#endif\\n\"\n" ++
  "\"\\n\"\n" ++
  "\"// The control words (A).\\n\"\n" ++
  "\"#define KA_DONE 0\\n\"\n" ++
  "\"#define KA_ERR 1\\n\"\n" ++
  "\"#define KA_HEAP 2\\n\"\n" ++
  "\"#define KA_QHEAD 3\\n\"\n" ++
  "\"#define KA_QTAIL 4\\n\"\n" ++
  "\"#define KA_SEQ 16\\n\"\n" ++
  "\"\\n\"\n" ++
  "\"// Where things are, in words of the arena (H) unless said otherwise.\\n\"\n" ++
  "\"typedef struct {\\n\"\n" ++
  "\"  KW ab;          // CPU address of the arena\\n\"\n" ++
  "\"  KW an;          // arena bytes\\n\"\n" ++
  "\"  KW gb;          // CPU address of the heap the device reads\\n\"\n" ++
  "\"  KW qcap;        // queue entries (a power of two)\\n\"\n" ++
  "\"  KW q0;          // queue data (4 words an entry)\\n\"\n" ++
  "\"  KW lane0;       // lane states (8 words a lane)\\n\"\n" ++
  "\"  KW fn0;         // the CPU functions the device knows: {address, label} pairs\\n\"\n" ++
  "\"  KW nfn;\\n\"\n" ++
  "\"  KW heap0;       // the heap, in chunks of K_CHUNK words\\n\"\n" ++
  "\"  KW heapw;       // words in the heap\\n\"\n" ++
  "\"  KW budget;      // steps a lane runs in one dispatch\\n\"\n" ++
  "\"  KW nlanes;\\n\"\n" ++
  "\"  KW fork_limit;  // tasks fork only this many levels deep\\n\"\n" ++
  "\"} KParams;\\n\"\n" ++
  "\"\\n\"\n" ++
  "\"#define PC_IDLE 0\\n\"\n" ++
  "\"#define PC_ROOT 1\\n\"\n" ++
  "\"#define PC_JOIN 2\\n\"\n" ++
  "\"#define PC_TASK 3\\n\"\n" ++
  "\"\\n\"\n" ++
  "\"#define K_CHUNK 4096\\n\"\n" ++
  "\"\\n\"\n" ++
  "\"// The errors a lane can hit.\\n\"\n" ++
  "\"#define KE_FX 2      // an effect, or a closure with no device code\\n\"\n" ++
  "\"#define KE_NAT 3     // a Nat past 2^63\\n\"\n" ++
  "\"#define KE_HEAP 4\\n\"\n" ++
  "\"#define KE_QUEUE 6\\n\"\n" ++
  "\"#define KE_MATCH 7\\n\"\n" ++
  "\"#define KE_PC 8\\n\"\n" ++
  "\"\\n\"\n" ++
  "\"typedef struct {\\n\"\n" ++
  "\"  KCOH KW *H;\\n\"\n" ++
  "\"  KDEV KW *G;\\n\"\n" ++
  "\"  KDEV KAU *A;\\n\"\n" ++
  "\"  KW ab, an, gb;\\n\"\n" ++
  "\"  KW pc, fp, rv, dep, hp, he, ax;\\n\"\n" ++
  "\"  KU err;\\n\"\n" ++
  "\"  KCP KParams *P;\\n\"\n" ++
  "\"} KCtx;\\n\"\n" ++
  "\"\\n\"\n" ++
  "\"#define KIMM(t) ((((KW)(t)) << 3) | 1)\\n\"\n" ++
  "\"#define KBOOL(b) ((b) ? KIMM(1) : KIMM(0))\\n\"\n" ++
  "\"#define KIX(c, v) (((v) - (c)->ab) >> 3)\\n\"\n" ++
  "\"#define KPTR(c, i) ((c)->ab + ((KW)(i) << 3))\\n\"\n" ++
  "\"#define KS(k) c->H[c->fp + 4 + (k)]\\n\"\n" ++
  "\"// A closure's code word: a label, where the CPU has a function address.\\n\"\n" ++
  "\"#define KCLO ((KW)0x7ff << 52)\\n\"\n" ++
  "\"\\n\"\n" ++
  "\"// The words of the object at v: in the arena or in the CPU's heap.\\n\"\n" ++
  "\"KINLINE bool k_in(KTHR KCtx *c, KW v) { return v - c->ab < c->an; }\\n\"\n" ++
  "\"KINLINE KW k_word(KTHR KCtx *c, KW v, KW i) {\\n\"\n" ++
  "\"  return k_in(c, v) ? c->H[((v - c->ab) >> 3) + i] : c->G[((v - c->gb) >> 3) + i];\\n\"\n" ++
  "\"}\\n\"\n" ++
  "\"KINLINE KW k_tag(KTHR KCtx *c, KW v) { return (v & 1) ? (v >> 3) : k_word(c, v, 0); }\\n\"\n" ++
  "\"#define KTAG(v) k_tag(c, v)\\n\"\n" ++
  "\"#define KFLD(v, i) k_word(c, v, 1 + (i))\\n\"\n" ++
  "\"\\n\"\n" ++
  "\"KINLINE void k_fail(KTHR KCtx *c, KU e) {\\n\"\n" ++
  "\"  if (c->err == 0) c->err = e;\\n\"\n" ++
  "\"}\\n\"\n" ++
  "\"\\n\"\n" ++
  "\"// n words from the lane's heap chunk; the word before an object holds its\\n\"\n" ++
  "\"// size (the host copies results out with it). Chunk 0 is scratch: a lane\\n\"\n" ++
  "\"// that ran out writes there, and stops.\\n\"\n" ++
  "\"KINLINE KW k_alloc(KTHR KCtx *c, KW n) {\\n\"\n" ++
  "\"  if (c->hp + n + 1 > c->he) {\\n\"\n" ++
  "\"    KW need = n + 1 > K_CHUNK ? n + 1 : K_CHUNK;\\n\"\n" ++
  "\"    KW k = (need + K_CHUNK - 1) / K_CHUNK;\\n\"\n" ++
  "\"    KW at = (KW)K_ADD(&c->A[KA_HEAP], (KU)k);\\n\"\n" ++
  "\"    KW start = c->P->heap0 + at * K_CHUNK;\\n\"\n" ++
  "\"    if (n + 1 > K_CHUNK || start + k * K_CHUNK > c->P->heap0 + c->P->heapw) {\\n\"\n" ++
  "\"      k_fail(c, KE_HEAP);\\n\"\n" ++
  "\"      c->hp = c->P->heap0;\\n\"\n" ++
  "\"      c->he = c->hp + K_CHUNK;\\n\"\n" ++
  "\"      return KPTR(c, c->P->heap0 + 1);\\n\"\n" ++
  "\"    }\\n\"\n" ++
  "\"    c->hp = start;\\n\"\n" ++
  "\"    c->he = start + k * K_CHUNK;\\n\"\n" ++
  "\"  }\\n\"\n" ++
  "\"  KW i = c->hp;\\n\"\n" ++
  "\"  c->H[i] = n;\\n\"\n" ++
  "\"  c->hp += n + 1;\\n\"\n" ++
  "\"  return KPTR(c, i + 1);\\n\"\n" ++
  "\"}\\n\"\n" ++
  "\"\\n\"\n" ++
  "\"KINLINE KW k_node(KTHR KCtx *c, KW tag, KW n) {\\n\"\n" ++
  "\"  KW p = k_alloc(c, n + 1);\\n\"\n" ++
  "\"  c->H[KIX(c, p)] = tag;\\n\"\n" ++
  "\"  return p;\\n\"\n" ++
  "\"}\\n\"\n" ++
  "\"\\n\"\n" ++
  "\"// A frame: [return pc, parent frame, aux, size, slots...], from the heap;\\n\"\n" ++
  "\"// one still on top of it when it returns gives its words back.\\n\"\n" ++
  "\"KINLINE KW k_push(KTHR KCtx *c, KW ret, KW fs) {\\n\"\n" ++
  "\"  KW f = KIX(c, k_alloc(c, fs));\\n\"\n" ++
  "\"  c->H[f] = ret;\\n\"\n" ++
  "\"  c->H[f + 1] = c->fp;\\n\"\n" ++
  "\"  c->H[f + 2] = 0;\\n\"\n" ++
  "\"  c->H[f + 3] = fs;\\n\"\n" ++
  "\"  return f;\\n\"\n" ++
  "\"}\\n\"\n" ++
  "\"\\n\"\n" ++
  "\"KINLINE void k_ret(KTHR KCtx *c, KW x) {\\n\"\n" ++
  "\"  KW f = c->fp;\\n\"\n" ++
  "\"  c->rv = x;\\n\"\n" ++
  "\"  c->ax = c->H[f + 2];\\n\"\n" ++
  "\"  c->pc = c->H[f];\\n\"\n" ++
  "\"  c->fp = c->H[f + 1];\\n\"\n" ++
  "\"  if (f + c->H[f + 3] == c->hp) c->hp = f - 1;\\n\"\n" ++
  "\"}\\n\"\n" ++
  "\"\\n\"\n" ++
  "\"// The queue (Vyukov's bounded MPMC queue): an entry is {pc, fp, rv, dep}.\\n\"\n" ++
  "\"KINLINE bool k_push_task(KTHR KCtx *c, KW pc, KW fp, KW rv, KW dep) {\\n\"\n" ++
  "\"  KW mask = c->P->qcap - 1;\\n\"\n" ++
  "\"  KU pos = K_LOAD(&c->A[KA_QTAIL]);\\n\"\n" ++
  "\"  for (int tries = 0;; tries++) {\\n\"\n" ++
  "\"    if (tries > 100000) return false;\\n\"\n" ++
  "\"    KU seq = K_LOAD(&c->A[KA_SEQ + (pos & mask)]);\\n\"\n" ++
  "\"    KI dif = (KI)(seq - pos);\\n\"\n" ++
  "\"    if (dif == 0) {\\n\"\n" ++
  "\"      KU e = pos;\\n\"\n" ++
  "\"      if (K_CAS(&c->A[KA_QTAIL], e, pos + 1)) break;\\n\"\n" ++
  "\"      pos = e;\\n\"\n" ++
  "\"    } else if (dif < 0) {\\n\"\n" ++
  "\"      return false;\\n\"\n" ++
  "\"    } else {\\n\"\n" ++
  "\"      pos = K_LOAD(&c->A[KA_QTAIL]);\\n\"\n" ++
  "\"    }\\n\"\n" ++
  "\"  }\\n\"\n" ++
  "\"  KW q = c->P->q0 + (KW)(pos & mask) * 4;\\n\"\n" ++
  "\"  c->H[q] = pc;\\n\"\n" ++
  "\"  c->H[q + 1] = fp;\\n\"\n" ++
  "\"  c->H[q + 2] = rv;\\n\"\n" ++
  "\"  c->H[q + 3] = dep;\\n\"\n" ++
  "\"  K_FENCE();\\n\"\n" ++
  "\"  K_STORE(&c->A[KA_SEQ + (pos & mask)], pos + 1);\\n\"\n" ++
  "\"  return true;\\n\"\n" ++
  "\"}\\n\"\n" ++
  "\"\\n\"\n" ++
  "\"KINLINE bool k_pop_task(KTHR KCtx *c) {\\n\"\n" ++
  "\"  KW mask = c->P->qcap - 1;\\n\"\n" ++
  "\"  KU pos = K_LOAD(&c->A[KA_QHEAD]);\\n\"\n" ++
  "\"  for (int tries = 0;; tries++) {\\n\"\n" ++
  "\"    if (tries > 64) return false;\\n\"\n" ++
  "\"    KU seq = K_LOAD(&c->A[KA_SEQ + (pos & mask)]);\\n\"\n" ++
  "\"    KI dif = (KI)(seq - (pos + 1));\\n\"\n" ++
  "\"    if (dif == 0) {\\n\"\n" ++
  "\"      KU e = pos;\\n\"\n" ++
  "\"      if (K_CAS(&c->A[KA_QHEAD], e, pos + 1)) break;\\n\"\n" ++
  "\"      pos = e;\\n\"\n" ++
  "\"    } else if (dif < 0) {\\n\"\n" ++
  "\"      return false;\\n\"\n" ++
  "\"    } else {\\n\"\n" ++
  "\"      pos = K_LOAD(&c->A[KA_QHEAD]);\\n\"\n" ++
  "\"    }\\n\"\n" ++
  "\"  }\\n\"\n" ++
  "\"  K_FENCE();\\n\"\n" ++
  "\"  KW q = c->P->q0 + (KW)(pos & mask) * 4;\\n\"\n" ++
  "\"  c->pc = c->H[q];\\n\"\n" ++
  "\"  c->fp = c->H[q + 1];\\n\"\n" ++
  "\"  c->rv = c->H[q + 2];\\n\"\n" ++
  "\"  c->dep = c->H[q + 3];\\n\"\n" ++
  "\"  K_FENCE();\\n\"\n" ++
  "\"  K_STORE(&c->A[KA_SEQ + (pos & mask)], pos + (KU)mask + 1);\\n\"\n" ++
  "\"  return true;\\n\"\n" ++
  "\"}\\n\"\n" ++
  "\"\\n\"\n" ++
  "\"// A join record: [pending, continuation pc, continuation frame, depth, values...].\\n\"\n" ++
  "\"KINLINE KW k_join_new(KTHR KCtx *c, KW n, KW cont) {\\n\"\n" ++
  "\"  KW j = KIX(c, k_alloc(c, 4 + n));\\n\"\n" ++
  "\"  c->H[j] = n;\\n\"\n" ++
  "\"  c->H[j + 1] = cont;\\n\"\n" ++
  "\"  c->H[j + 2] = c->fp;\\n\"\n" ++
  "\"  c->H[j + 3] = c->dep;\\n\"\n" ++
  "\"  return j;\\n\"\n" ++
  "\"}\\n\"\n" ++
  "\"\\n\"\n" ++
  "\"// A value arrives at a join; the last one continues the forking frame.\\n\"\n" ++
  "\"KINLINE void k_arrive(KTHR KCtx *c, KW j, KW i, KW x) {\\n\"\n" ++
  "\"  c->H[j + 4 + i] = x;\\n\"\n" ++
  "\"  K_FENCE();\\n\"\n" ++
  "\"  KU old = K_SUB(K_ATW(&c->H[j]), 1u);\\n\"\n" ++
  "\"  if (old == 1) {\\n\"\n" ++
  "\"    K_FENCE();\\n\"\n" ++
  "\"    c->pc = c->H[j + 1];\\n\"\n" ++
  "\"    c->fp = c->H[j + 2];\\n\"\n" ++
  "\"    c->dep = c->H[j + 3];\\n\"\n" ++
  "\"  } else {\\n\"\n" ++
  "\"    c->pc = PC_IDLE;\\n\"\n" ++
  "\"  }\\n\"\n" ++
  "\"}\\n\"\n" ++
  "\"\\n\"\n" ++
  "\"// The label of a CPU function, from the table the host fills.\\n\"\n" ++
  "\"KINLINE KW k_fn_label(KTHR KCtx *c, KW f) {\\n\"\n" ++
  "\"  KW t = c->P->fn0;\\n\"\n" ++
  "\"  for (KW i = 0; i < c->P->nfn; i++) {\\n\"\n" ++
  "\"    if (c->H[t + 2 * i] == f) return c->H[t + 2 * i + 1];\\n\"\n" ++
  "\"  }\\n\"\n" ++
  "\"  return 0;\\n\"\n" ++
  "\"}\\n\"\n" ++
  "\"\\n\"\n" ++
  "\"// Natives\\n\"\n" ++
  "\"// -------\\n\"\n" ++
  "\"\\n\"\n" ++
  "\"#define KNAT_BIG(x) ((x) >> 63)\\n\"\n" ++
  "\"KINLINE KW k_nat(KTHR KCtx *c, KW a) { if (KNAT_BIG(a)) k_fail(c, KE_NAT); return a; }\\n\"\n" ++
  "\"KINLINE bool k_nge(KTHR KCtx *c, KW x, KW k) { k_nat(c, x); return x >= k; }\\n\"\n" ++
  "\"KINLINE bool k_nz(KTHR KCtx *c, KW x) { k_nat(c, x); return x != 0; }\\n\"\n" ++
  "\"KINLINE KW k_nat_add(KTHR KCtx *c, KW a, KW b) {\\n\"\n" ++
  "\"  KW s = a + b;\\n\"\n" ++
  "\"  if (KNAT_BIG(a | b | s)) k_fail(c, KE_NAT);\\n\"\n" ++
  "\"  return s;\\n\"\n" ++
  "\"}\\n\"\n" ++
  "\"KINLINE KW k_nat_mul(KTHR KCtx *c, KW a, KW b) {\\n\"\n" ++
  "\"  if (KNAT_BIG(a | b) || (a != 0 && b > ((KW)1 << 63) / a)) { k_fail(c, KE_NAT); return 0; }\\n\"\n" ++
  "\"  KW p = a * b;\\n\"\n" ++
  "\"  if (KNAT_BIG(p)) k_fail(c, KE_NAT);\\n\"\n" ++
  "\"  return p;\\n\"\n" ++
  "\"}\\n\"\n" ++
  "\"KINLINE KW k_cmp3(KW a, KW b) { return a < b ? KIMM(0) : a == b ? KIMM(1) : KIMM(2); }\\n\"\n" ++
  "\"#define KN1(name, expr) KINLINE KW KF_Nat_d##name(KTHR KCtx *c, KW a) { k_nat(c, a); return expr; }\\n\"\n" ++
  "\"#define KN2(name, expr) KINLINE KW KF_Nat_d##name(KTHR KCtx *c, KW a, KW b) { k_nat(c, a); k_nat(c, b); return expr; }\\n\"\n" ++
  "\"KN1(double, k_nat_add(c, a, a))\\n\"\n" ++
  "\"KN2(add, k_nat_add(c, a, b))\\n\"\n" ++
  "\"KN2(sub, a > b ? a - b : 0)\\n\"\n" ++
  "\"KN2(mul, k_nat_mul(c, a, b))\\n\"\n" ++
  "\"KN2(div, b == 0 ? 0 : a / b)\\n\"\n" ++
  "\"KN2(mod, b == 0 ? a : a % b)\\n\"\n" ++
  "\"KN2(cmp, k_cmp3(a, b))\\n\"\n" ++
  "\"KN2(is__eq, KBOOL(a == b))\\n\"\n" ++
  "\"KN2(is__ne, KBOOL(a != b))\\n\"\n" ++
  "\"KN2(is__lt, KBOOL(a < b))\\n\"\n" ++
  "\"KN2(is__le, KBOOL(a <= b))\\n\"\n" ++
  "\"KN2(is__gt, KBOOL(a > b))\\n\"\n" ++
  "\"KN2(is__ge, KBOOL(a >= b))\\n\"\n" ++
  "\"KN2(min, a < b ? a : b)\\n\"\n" ++
  "\"KN2(max, a < b ? b : a)\\n\"\n" ++
  "\"KINLINE KW KF_Nat_ddivmod(KTHR KCtx *c, KW a, KW b) {\\n\"\n" ++
  "\"  k_nat(c, a);\\n\"\n" ++
  "\"  k_nat(c, b);\\n\"\n" ++
  "\"  KW p = k_node(c, 0, 2);\\n\"\n" ++
  "\"  c->H[KIX(c, p) + 1] = b == 0 ? 0 : a / b;\\n\"\n" ++
  "\"  c->H[KIX(c, p) + 2] = b == 0 ? a : a % b;\\n\"\n" ++
  "\"  return p;\\n\"\n" ++
  "\"}\\n\"\n" ++
  "\"KINLINE KW KF_Nat_dpow(KTHR KCtx *c, KW a, KW n) {\\n\"\n" ++
  "\"  k_nat(c, n);\\n\"\n" ++
  "\"  KW r = 1;\\n\"\n" ++
  "\"  for (KW i = 0; i < n && c->err == 0; i++) r = k_nat_mul(c, r, a);\\n\"\n" ++
  "\"  return r;\\n\"\n" ++
  "\"}\\n\"\n" ++
  "\"KINLINE KW KF_Nat_dshow(KTHR KCtx *c, KW a) { k_fail(c, KE_FX); return 0; }\\n\"\n" ++
  "\"\\n\"\n" ++
  "\"#define KU32(x) ((KW)(KU)(x))\\n\"\n" ++
  "\"#define KU1(name, expr) KINLINE KW KF_U32_d##name(KTHR KCtx *c, KW a) { return expr; }\\n\"\n" ++
  "\"#define KU2(name, expr) KINLINE KW KF_U32_d##name(KTHR KCtx *c, KW a, KW b) { return expr; }\\n\"\n" ++
  "\"KU1(inc, KU32(a + 1))\\n\"\n" ++
  "\"KU2(add, KU32(a + b))\\n\"\n" ++
  "\"KU2(sub, KU32(a - b))\\n\"\n" ++
  "\"KU2(mul, KU32((KU)a * (KU)b))\\n\"\n" ++
  "\"KU2(div, b == 0 ? 0 : KU32(a) / KU32(b))\\n\"\n" ++
  "\"KU2(mod, b == 0 ? a : KU32(a) % KU32(b))\\n\"\n" ++
  "\"KU1(not, KU32(~a))\\n\"\n" ++
  "\"KU2(and, a & b)\\n\"\n" ++
  "\"KU2(or, a | b)\\n\"\n" ++
  "\"KU2(xor, a ^ b)\\n\"\n" ++
  "\"KU1(shl, KU32(a << 1))\\n\"\n" ++
  "\"KU1(shr, a >> 1)\\n\"\n" ++
  "\"KU2(shln, b >= 32 ? 0 : KU32(a << b))\\n\"\n" ++
  "\"KU2(shrn, b >= 32 ? 0 : a >> b)\\n\"\n" ++
  "\"KU2(cmp, k_cmp3(a, b))\\n\"\n" ++
  "\"KU2(is__eq, KBOOL(a == b))\\n\"\n" ++
  "\"KU2(is__ne, KBOOL(a != b))\\n\"\n" ++
  "\"KU2(is__lt, KBOOL(a < b))\\n\"\n" ++
  "\"KU2(is__le, KBOOL(a <= b))\\n\"\n" ++
  "\"KU2(is__gt, KBOOL(a > b))\\n\"\n" ++
  "\"KU2(is__ge, KBOOL(a >= b))\\n\"\n" ++
  "\"KU1(is__zero, KBOOL(a == 0))\\n\"\n" ++
  "\"KU1(is__even, KBOOL((a & 1) == 0))\\n\"\n" ++
  "\"KU1(to__nat, a)\\n\"\n" ++
  "\"KU1(from__nat, KU32(k_nat(c, a)))\\n\"\n" ++
  "\"KU2(min, a < b ? a : b)\\n\"\n" ++
  "\"KU2(max, a < b ? b : a)\\n\"\n" ++
  "\"KINLINE KW KF_U32_dpow(KTHR KCtx *c, KW a, KW n) {\\n\"\n" ++
  "\"  k_nat(c, n);\\n\"\n" ++
  "\"  KU r = 1, b = (KU)a;\\n\"\n" ++
  "\"  for (KW e = n; e; e >>= 1) {\\n\"\n" ++
  "\"    if (e & 1) r *= b;\\n\"\n" ++
  "\"    b *= b;\\n\"\n" ++
  "\"  }\\n\"\n" ++
  "\"  return r;\\n\"\n" ++
  "\"}\\n\"\n" ++
  "\"KINLINE KW KF_U32_dlog2(KTHR KCtx *c, KW n) {\\n\"\n" ++
  "\"  KW d = 0;\\n\"\n" ++
  "\"  while (n > 1) { d++; n >>= 1; }\\n\"\n" ++
  "\"  return d;\\n\"\n" ++
  "\"}\\n\"\n" ++
  "\"KU1(to__f32, KUF((float)(KU)a))\\n\"\n" ++
  "\"\\n\"\n" ++
  "\"#define KF1(name, expr) KINLINE KW KF_F32_d##name(KTHR KCtx *c, KW a) { float x = KF(a); return expr; }\\n\"\n" ++
  "\"#define KF2(name, expr) KINLINE KW KF_F32_d##name(KTHR KCtx *c, KW a, KW b) { float x = KF(a), y = KF(b); return expr; }\\n\"\n" ++
  "\"KF2(add, KUF(x + y))\\n\"\n" ++
  "\"KF2(sub, KUF(x - y))\\n\"\n" ++
  "\"KF2(mul, KUF(x * y))\\n\"\n" ++
  "\"KF2(div, KUF(x / y))\\n\"\n" ++
  "\"KF2(mod, KUF(KMF(fmod)(x, y)))\\n\"\n" ++
  "\"KF2(pow, KUF(KMF(pow)(x, y)))\\n\"\n" ++
  "\"KF2(atan2, KUF(KMF(atan2)(x, y)))\\n\"\n" ++
  "\"KF2(is__eq, KBOOL(x == y))\\n\"\n" ++
  "\"KF2(is__ne, KBOOL(x != y))\\n\"\n" ++
  "\"KF2(is__lt, KBOOL(x < y))\\n\"\n" ++
  "\"KF2(is__le, KBOOL(x <= y))\\n\"\n" ++
  "\"KF2(is__gt, KBOOL(x > y))\\n\"\n" ++
  "\"KF2(is__ge, KBOOL(x >= y))\\n\"\n" ++
  "\"KF1(neg, KUF(-x))\\n\"\n" ++
  "\"KF1(abs, KUF(KMF(fabs)(x)))\\n\"\n" ++
  "\"KF1(sqrt, KUF(KMF(sqrt)(x)))\\n\"\n" ++
  "\"KF1(exp, KUF(KMF(exp)(x)))\\n\"\n" ++
  "\"KF1(log, KUF(KMF(log)(x)))\\n\"\n" ++
  "\"KF1(log2, KUF(KMF(log2)(x)))\\n\"\n" ++
  "\"KF1(log10, KUF(KMF(log10)(x)))\\n\"\n" ++
  "\"KF1(sin, KUF(KMF(sin)(x)))\\n\"\n" ++
  "\"KF1(cos, KUF(KMF(cos)(x)))\\n\"\n" ++
  "\"KF1(tan, KUF(KMF(tan)(x)))\\n\"\n" ++
  "\"KF1(asin, KUF(KMF(asin)(x)))\\n\"\n" ++
  "\"KF1(acos, KUF(KMF(acos)(x)))\\n\"\n" ++
  "\"KF1(atan, KUF(KMF(atan)(x)))\\n\"\n" ++
  "\"KF1(sinh, KUF(KMF(sinh)(x)))\\n\"\n" ++
  "\"KF1(cosh, KUF(KMF(cosh)(x)))\\n\"\n" ++
  "\"KF1(tanh, KUF(KMF(tanh)(x)))\\n\"\n" ++
  "\"KF1(floor, KUF(KMF(floor)(x)))\\n\"\n" ++
  "\"KF1(ceil, KUF(KMF(ceil)(x)))\\n\"\n" ++
  "\"KF1(trunc, KUF(KMF(trunc)(x)))\\n\"\n" ++
  "\"KF1(bits, KU32(a))\\n\"\n" ++
  "\"KF1(to__u32, x <= 0.0f ? 0 : x >= 4294967295.0f ? (KW)0xffffffffu : (KW)(KU)x)\\n\"\n" ++
  "\"KINLINE KW KF_F32_dshow(KTHR KCtx *c, KW a) { k_fail(c, KE_FX); return 0; }\\n\"\n" ++
  "\"KINLINE KW KF_F32_dread(KTHR KCtx *c, KW a) { k_fail(c, KE_FX); return 0; }\\n\"\n" ++
  "\"\\n\"\n" ++
  "\"\\n\"\n" ++
  "\n"

def mid_lit() -> String:
  "\"\\n\"\n" ++
  "\"// Applies closure f to x; the value goes to block ret.\\n\"\n" ++
  "\"KINLINE void k_call_clo(KTHR KCtx *c, KW f, KW x, KW ret) {\\n\"\n" ++
  "\"  KW fw = k_word(c, f, 0), ar = k_word(c, f, 1), n = k_word(c, f, 2);\\n\"\n" ++
  "\"  KW l = (fw >> 52) == 0x7ff ? (fw & 0xffffffffu) : k_fn_label(c, fw);\\n\"\n" ++
  "\"  if (l == 0 || l >= K_NLABELS) {\\n\"\n" ++
  "\"    k_fail(c, KE_FX);\\n\"\n" ++
  "\"    c->rv = 0;\\n\"\n" ++
  "\"    c->pc = ret;\\n\"\n" ++
  "\"    return;\\n\"\n" ++
  "\"  }\\n\"\n" ++
  "\"  if (n + 1 < ar) {\\n\"\n" ++
  "\"    KW p = k_alloc(c, n + 4);\\n\"\n" ++
  "\"    KW w = KIX(c, p);\\n\"\n" ++
  "\"    c->H[w] = KCLO | l;\\n\"\n" ++
  "\"    c->H[w + 1] = ar;\\n\"\n" ++
  "\"    c->H[w + 2] = n + 1;\\n\"\n" ++
  "\"    for (KW i = 0; i < n; i++) c->H[w + 3 + i] = k_word(c, f, 3 + i);\\n\"\n" ++
  "\"    c->H[w + 3 + n] = x;\\n\"\n" ++
  "\"    c->rv = p;\\n\"\n" ++
  "\"    c->pc = ret;\\n\"\n" ++
  "\"    return;\\n\"\n" ++
  "\"  }\\n\"\n" ++
  "\"  KW nf = k_push(c, ret, K_FRAME[l]);\\n\"\n" ++
  "\"  for (KW i = 0; i < n; i++) c->H[nf + 4 + i] = k_word(c, f, 3 + i);\\n\"\n" ++
  "\"  c->H[nf + 4 + n] = x;\\n\"\n" ++
  "\"  c->fp = nf;\\n\"\n" ++
  "\"  c->pc = l;\\n\"\n" ++
  "\"}\\n\"\n" ++
  "\"\\n\"\n" ++
  "\"#ifdef __METAL_VERSION__\\n\"\n" ++
  "\"kernel void bend_kernel(device coherent(device) KW *H [[buffer(0)]], device KAU *A [[buffer(1)]],\\n\"\n" ++
  "\"  constant KParams &PP [[buffer(2)]], device KW *G [[buffer(3)]], uint lane [[thread_position_in_grid]]) {\\n\"\n" ++
  "\"  constant KParams *P = &PP;\\n\"\n" ++
  "\"#else\\n\"\n" ++
  "\"static void bend_kernel(KW *H, KAU *A, const KParams *P, KW *G, uint32_t lane) {\\n\"\n" ++
  "\"#endif\\n\"\n" ++
  "\"  if (lane >= P->nlanes) return;\\n\"\n" ++
  "\"  KCtx cx;\\n\"\n" ++
  "\"  KTHR KCtx *c = &cx;\\n\"\n" ++
  "\"  c->H = H;\\n\"\n" ++
  "\"  c->G = G;\\n\"\n" ++
  "\"  c->A = A;\\n\"\n" ++
  "\"  c->P = P;\\n\"\n" ++
  "\"  c->ab = P->ab;\\n\"\n" ++
  "\"  c->an = P->an;\\n\"\n" ++
  "\"  c->gb = P->gb;\\n\"\n" ++
  "\"  c->err = 0;\\n\"\n" ++
  "\"  KW ls = P->lane0 + (KW)lane * 8;\\n\"\n" ++
  "\"  c->pc = H[ls];\\n\"\n" ++
  "\"  c->fp = H[ls + 1];\\n\"\n" ++
  "\"  c->rv = H[ls + 2];\\n\"\n" ++
  "\"  c->dep = H[ls + 3];\\n\"\n" ++
  "\"  c->hp = H[ls + 4];\\n\"\n" ++
  "\"  c->he = H[ls + 5];\\n\"\n" ++
  "\"  c->ax = H[ls + 6];\\n\"\n" ++
  "\"  KW budget = P->budget;\\n\"\n" ++
  "\"  for (KW step = 0; step < budget; step++) {\\n\"\n" ++
  "\"    if (c->pc == PC_IDLE) {\\n\"\n" ++
  "\"      if (K_LOAD(&A[KA_DONE]) != 0 || K_LOAD(&A[KA_ERR]) != 0) break;\\n\"\n" ++
  "\"      if (!k_pop_task(c)) continue;\\n\"\n" ++
  "\"    }\\n\"\n" ++
  "\"    switch (c->pc) {\\n\"\n" ++
  "\"      case PC_ROOT: {\\n\"\n" ++
  "\"        H[2] = c->rv;\\n\"\n" ++
  "\"        K_FENCE();\\n\"\n" ++
  "\"        K_STORE(&A[KA_DONE], 1u);\\n\"\n" ++
  "\"        c->pc = PC_IDLE;\\n\"\n" ++
  "\"        break;\\n\"\n" ++
  "\"      }\\n\"\n" ++
  "\"      case PC_JOIN: {\\n\"\n" ++
  "\"        k_arrive(c, c->fp, c->ax, c->rv);\\n\"\n" ++
  "\"        break;\\n\"\n" ++
  "\"      }\\n\"\n" ++
  "\"      case PC_TASK: {\\n\"\n" ++
  "\"        // A forked thunk: rv is its closure, fp its join, dep its depth\\n\"\n" ++
  "\"        // and (dep >> 32) its index.\\n\"\n" ++
  "\"        KW i = c->dep >> 32;\\n\"\n" ++
  "\"        c->dep &= 0xffffffffu;\\n\"\n" ++
  "\"        k_call_clo(c, c->rv, 0, PC_JOIN);\\n\"\n" ++
  "\"        c->H[c->fp + 2] = i;\\n\"\n" ++
  "\"        break;\\n\"\n" ++
  "\"      }\\n\"\n" ++
  "\"\\n\"\n" ++
  "\n"

def tail_lit() -> String:
  "\"      default: {\\n\"\n" ++
  "\"        k_fail(c, KE_PC);\\n\"\n" ++
  "\"        break;\\n\"\n" ++
  "\"      }\\n\"\n" ++
  "\"    }\\n\"\n" ++
  "\"    if (c->err != 0) {\\n\"\n" ++
  "\"      KU z = 0;\\n\"\n" ++
  "\"      K_CAS(&A[KA_ERR], z, c->err);\\n\"\n" ++
  "\"      break;\\n\"\n" ++
  "\"    }\\n\"\n" ++
  "\"  }\\n\"\n" ++
  "\"  H[ls] = c->pc;\\n\"\n" ++
  "\"  H[ls + 1] = c->fp;\\n\"\n" ++
  "\"  H[ls + 2] = c->rv;\\n\"\n" ++
  "\"  H[ls + 3] = c->dep;\\n\"\n" ++
  "\"  H[ls + 4] = c->hp;\\n\"\n" ++
  "\"  H[ls + 5] = c->he;\\n\"\n" ++
  "\"  H[ls + 6] = c->ax;\\n\"\n" ++
  "\"}\\n\"\n" ++
  "\"\\n\"\n" ++
  "\n"
