  "KU2(max, a < b ? b : a)\n" ++
  "KINLINE KW KF_U32_dpow(KTHR KCtx *c, KW a, KW n) {\n" ++
  "  k_nat(c, n);\n" ++
  "  KU r = 1, b = (KU)a;\n" ++
  "  for (KW e = n; e; e >>= 1) {\n" ++
  "    if (e & 1) r *= b;\n" ++
  "    b *= b;\n" ++
  "  }\n" ++
  "  return r;\n" ++
  "}\n" ++
