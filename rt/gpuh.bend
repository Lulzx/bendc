  "\n" ++
  "// A join record: [pending, continuation pc, continuation frame, depth, values...].\n" ++
  "KINLINE KW k_join_new(KTHR KCtx *c, KW n, KW cont) {\n" ++
  "  KW j = KIX(c, k_alloc(c, 4 + n));\n" ++
  "  c->H[j] = n;\n" ++
  "  c->H[j + 1] = cont;\n" ++
  "  c->H[j + 2] = c->fp;\n" ++
  "  c->H[j + 3] = c->dep;\n" ++
  "  return j;\n" ++
  "}\n" ++
  "\n" ++
  "// A value arrives at a join; the last one continues the forking frame.\n" ++
  "KINLINE void k_arrive(KTHR KCtx *c, KW j, KW i, KW x) {\n" ++
  "  c->H[j + 4 + i] = x;\n" ++
  "  K_FENCE();\n" ++
  "  KU old = K_SUB(K_ATW(&c->H[j]), 1u);\n" ++
  "  if (old == 1) {\n" ++
  "    K_FENCE();\n" ++
  "    c->pc = c->H[j + 1];\n" ++
  "    c->fp = c->H[j + 2];\n" ++
  "    c->dep = c->H[j + 3];\n" ++
  "  } else {\n" ++
  "    c->pc = PC_IDLE;\n" ++
  "  }\n" ++
  "}\n" ++
