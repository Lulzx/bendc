  "\n" ++
  "#define KNAT_BIG(x) ((x) >> 63)\n" ++
  "KINLINE KW k_nat(KTHR KCtx *c, KW a) { if (KNAT_BIG(a)) k_fail(c, KE_NAT); return a; }\n" ++
