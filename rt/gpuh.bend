  "  c->H[KIX(c, p) + 2] = b == 0 ? a : a % b;\n" ++
  "  return p;\n" ++
  "}\n" ++
  "KINLINE KW KF_Nat_dpow(KTHR KCtx *c, KW a, KW n) {\n" ++
  "  k_nat(c, n);\n" ++
