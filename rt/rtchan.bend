  "// Chan effects\n" ++
  "// ============\n" ++
  "//\n" ++
  "// Base's effs/chan.c (Bend 2.0.26 on) defines the channel rows itself, in\n" ++
  "// memory the collector does not scan. bendc splices this file in its place:\n" ++
  "// the same effects, on the rows of bendrt.h, whose rings the collector marks\n" ++
  "// (io_hook) and whose frees hold gc_lock.\n" ++
  "\n" ++
  "#ifdef CID_CHAN_NEW\n" ++
  "\n" ++
  "Term chan_new_run(Env e, Term* f, IoWork* w) {\n" ++
  "  return chan_open((u32)f[0]);\n" ++
  "}\n" ++
  "\n" ++
  "static void __attribute__((constructor)) chan_new_use(void) {\n" ++
  "  io_eff(CID_CHAN_NEW, chan_new_run, 0);\n" ++
