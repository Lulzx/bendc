  "#ifdef CID_CHAN_SEND\n" ++
  "\n" ++
  "Term chan_send_run(Env e, Term* f, IoWork* w) {\n" ++
  "  ChanRow* row = chan_at(f[0]);\n" ++
  "  if (row == NULL || row->shut) {\n" ++
  "    term_drop(e, f[1]);\n" ++
  "    return chan_bool(false);\n" ++
  "  }\n" ++
  "  if (row->wait.head != NULL && row->wait.head->item == TERM_HOLE) {\n" ++
  "    chan_wake(row, chan_some(e, f[1]));\n" ++
  "    return chan_bool(true);\n" ++
  "  }\n" ++
  "  if (row->size < row->room) {\n" ++
  "    row->ring[(row->head + row->size) % row->room] = f[1];\n" ++
  "    row->size += 1;\n" ++
  "    return chan_bool(true);\n" ++
  "  }\n" ++
  "  return chan_park(row, w, f[1]);\n" ++
  "}\n" ++
  "\n" ++
  "static void __attribute__((constructor)) chan_send_use(void) {\n" ++
  "  io_eff(CID_CHAN_SEND, chan_send_run, 0);\n" ++
  "}\n" ++
  "\n" ++
  "#endif\n" ++
  "\n" ++
  "#ifdef CID_CHAN_RECV\n" ++
  "\n" ++
  "Term chan_recv_run(Env e, Term* f, IoWork* w) {\n" ++
  "  ChanRow* row = chan_at(f[0]);\n" ++
  "  if (row == NULL) {\n" ++
  "    return term_pak(CID_NONE, 0);\n" ++
  "  }\n" ++
  "  if (row->size > 0) {\n" ++
  "    Term v = chan_take(row);\n" ++
  "    if (row->shut && row->size == 0) {\n" ++
  "      chan_free(row);\n" ++
  "    }\n" ++
  "    return chan_some(e, v);\n" ++
  "  }\n"

def src.p1() -> String:
  "  if (row->wait.head != NULL && row->wait.head->item != TERM_HOLE) {\n" ++
  "    return chan_some(e, chan_wake(row, chan_bool(true)));\n" ++
  "  }\n" ++
  "  if (row->shut) {\n" ++
  "    chan_free(row);\n" ++
  "    return term_pak(CID_NONE, 0);\n" ++
  "  }\n" ++
  "  return chan_park(row, w, TERM_HOLE);\n" ++
  "}\n" ++
  "\n" ++
